# Copy to .env and replace every value. .env is git-ignored; never commit real secrets.
# Generate strong values with:  openssl rand -base64 48

# Shared HMAC key: auth-service signs tokens with it, the gateway and services verify them.
# Must be at least 32 bytes.
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
JWT_ISSUER=ecommerce-auth-service
JWT_ACCESS_TOKEN_TTL=60m

# One database and one database user per service. Each service reads these as
# DB_URL, DB_USERNAME, and DB_PASSWORD; the prefixes keep them apart in one file.
AUTH_DB_URL=jdbc:mysql://127.0.0.1:3306/auth_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=replace-me

PRODUCT_DB_URL=jdbc:mysql://127.0.0.1:3306/product_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PRODUCT_DB_USERNAME=product_user
PRODUCT_DB_PASSWORD=replace-me

INVENTORY_DB_URL=jdbc:mysql://127.0.0.1:3306/inventory_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
INVENTORY_DB_USERNAME=inventory_user
INVENTORY_DB_PASSWORD=replace-me

# Optional first admin account. Leave blank to skip. Password needs 12+ characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Redis (product cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
PRODUCT_CACHE_TTL=10m
CATEGORY_CACHE_TTL=30m

# inventory-service -> product-service (checks a product exists before stock is created)
PRODUCT_SERVICE_URL=http://localhost:8082

# Set to false in production to hide /v3/api-docs and Swagger UI.
API_DOCS_ENABLED=true

# Gateway
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SERVICE_URI=http://localhost:8081
PRODUCT_SERVICE_URI=http://localhost:8082
INVENTORY_SERVICE_URI=http://localhost:8083
